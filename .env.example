# ============================================================
# CONFIGURATION DU BOT DE TRADING BINANCE
# Copiez ce fichier en .env et remplissez vos valeurs.
# NE JAMAIS commiter .env dans git.
# ============================================================

# ------------------------------------------------------------
# MODE DE FONCTIONNEMENT
# ------------------------------------------------------------
# PAPER_TRADING=true  → simulation locale (défaut sécurisé, aucun ordre envoyé)
# TESTNET=true        → ordres réels sur testnet.binance.vision (argent fictif)
# Les deux à false    → trading RÉEL sur Binance production (ARGENT RÉEL !)
PAPER_TRADING=true
TESTNET=false

# ------------------------------------------------------------
# CLÉS API PRODUCTION (utilisées si PAPER_TRADING=false et TESTNET=false)
# À créer sur : https://www.binance.com/fr/my/settings/api-management
# ------------------------------------------------------------
BINANCE_API_KEY=votre_cle_api_binance_production
BINANCE_SECRET_KEY=votre_cle_secrete_binance_production

# ------------------------------------------------------------
# CLÉS API TESTNET (utilisées si TESTNET=true)
# À obtenir gratuitement sur : https://testnet.binance.vision
# Connectez-vous avec GitHub → "Generate HMAC_SHA256 Key"
# ------------------------------------------------------------
BINANCE_TESTNET_API_KEY=votre_cle_api_testnet
BINANCE_TESTNET_SECRET_KEY=votre_cle_secrete_testnet

# ------------------------------------------------------------
# PARAMÈTRES TRADING (optionnels — valeurs par défaut ci-dessous)
# ------------------------------------------------------------
INITIAL_CAPITAL=1000.0
TRADING_PAIRS=BTC/USDT,ETH/USDT,BNB/USDT

# Risque par trade : 2% du capital = ~20 USDT avec 1000 USDT
# RISK_PER_TRADE_PCT=0.02

# Stop-Loss à 1% sous le prix d'entrée
# STOP_LOSS_PCT=0.01

# Timeframe des bougies
# TIMEFRAME=5m

# Fichiers de sortie
# LOG_FILE=trading_bot.log
# PAPER_STATE_FILE=paper_state.json
