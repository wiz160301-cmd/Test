# Copiez ce fichier en .env et remplissez vos valeurs
# NE JAMAIS commiter .env dans git

# Clés API Binance (optionnelles en paper trading)
BINANCE_API_KEY=votre_cle_api_binance
BINANCE_SECRET_KEY=votre_cle_secrete_binance

# Mettre à "false" UNIQUEMENT quand vous êtes prêt à trader avec de l'argent réel
PAPER_TRADING=true

# Capital initial en USDT (équivalent 1000€)
INITIAL_CAPITAL=1000.0

# Paires tradées (séparées par des virgules)
TRADING_PAIRS=BTC/USDT,ETH/USDT,BNB/USDT

# Paramètres optionnels
# RISK_PER_TRADE_PCT=0.02
# STOP_LOSS_PCT=0.01
# TIMEFRAME=5m
# LOG_FILE=trading_bot.log
# PAPER_STATE_FILE=paper_state.json
